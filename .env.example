# 整段 Cookie header（含 cf_clearance 與 civitai 的登入 cookie）
# 取得方式：DevTools -> Network -> 任一請求 -> Request Headers -> Cookie -> 整段複製
CIVITAI_COOKIE=

# cf_clearance 綁 IP + User-Agent：這裡要填「當初產生 cookie 的那個瀏覽器」的 UA
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/157.0.0.0 Safari/537.36

# CIVITAI_URL=https://civitai.red/
# HEADLESS=true
# DEBUG=false
